# Copy to .env.production in project root; do not commit actual values.
DOMAIN=apk.example.org
# Generate locally, e.g. Python secrets.token_hex(32). Do not reuse the demo password.
POSTGRES_PASSWORD=
# Absolute host directory containing trusted fullchain.pem and privkey.pem.
TLS_DIR=/etc/opora-apk/tls
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_ADMIN_IDS=
MAX_APP_URL=
